{
  "action_manifest_version": 0,
  "alias_info": {},
  "app_key": "system.generated.wayvr",
  "bindings": {
    "/actions/default": {
      "sources": [
        {
          "inputs": {
            "click": {
              "output": "/actions/default/in/showhide"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/options"
        },
        {
          "inputs": {
            "touch": {
              "output": "/actions/default/in/clickmodifierright"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/triangle"
        },
        {
          "inputs": {
            "touch": {
              "output": "/actions/default/in/clickmodifiermiddle"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/square"
        },
        {
          "inputs": {
            "touch": {
              "output": "/actions/default/in/clickmodifierright"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/circle"
        },
        {
          "inputs": {
            "touch": {
              "output": "/actions/default/in/clickmodifiermiddle"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/cross"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/default/in/click"
            },
            "touch": {
              "output": "/actions/default/in/movemouse"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/left/input/l2"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/default/in/click"
            },
            "touch": {
              "output": "/actions/default/in/movemouse"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/right/input/r2"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/default/in/grab"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/left/input/l1"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/default/in/grab"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/right/input/r1"
        },
        {
          "inputs": {
            "scroll": {
              "output": "/actions/default/in/scroll"
            }
          },
          "mode": "scroll",
          "parameters": {
            "scroll_mode": "smooth"
          },
          "path": "/user/hand/left/input/left_stick"
        },
        {
          "inputs": {
            "scroll": {
              "output": "/actions/default/in/scroll"
            }
          },
          "mode": "scroll",
          "parameters": {
            "scroll_mode": "smooth"
          },
          "path": "/user/hand/right/input/right_stick"
        }
      ],
      "poses": [
        {
          "output": "/actions/default/in/lefthand",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/default/in/righthand",
          "path": "/user/hand/right/pose/tip"
        }
      ],
      "haptics": [
        {
          "output": "/actions/default/out/hapticsleft",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/default/out/hapticsright",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    }
  },
  "category": "steamvr_input",
  "controller_type": "playstation_vr2_sense",
  "description": "Our own binding for the WayVR desktop overlay (a separate program, not part of this driver), laid out like WayVR's Oculus Touch defaults except show/hide: a press of Options (right controller) shows/hides the overlays (as on monado-service), L2/R2 click (touch shows the pointer), L1/R1 grab, sticks scroll, touching Triangle/Circle gives the right-click laser and Square/Cross the middle-click laser.",
  "name": "WayVR desktop overlay bindings for PlayStation VR2 Sense controllers",
  "options": {
    "mirror_actions": false,
    "simulated_controller_type": "none"
  },
  "simulated_actions": []
}
