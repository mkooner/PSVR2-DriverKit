diff --git a/src/xrt/drivers/psvr2/psvr2_pose_filter.h b/src/xrt/drivers/psvr2/psvr2_pose_filter.h
index 87681e746..c2f14460c 100644
--- a/src/xrt/drivers/psvr2/psvr2_pose_filter.h
+++ b/src/xrt/drivers/psvr2/psvr2_pose_filter.h
@@ -123,6 +123,28 @@ struct psvr2_pose_filter_params
 	 * drifted from SLAM by up to cm in the 19:12 replay.
 	 */
 	bool ref_imu_decides;
+	/*!
+	 * IMU check of every SLAM position (accelerometer-aided position, used when there is no referee: ref_jump_m 0).
+	 * A SLAM position further than imu_jump_m (+ imu_jump_per_rad_s * turn rate + imu_jump_per_s * time since the last
+	 * SLAM position) from where the IMU says the head is, is a SLAM error: the difference goes into an offset on SLAM
+	 * instead of into the pose, so the pose follows the IMU through it. The offset is brought back to zero at
+	 * imu_offset_rate_mps plus imu_offset_motion_gain times the head's speed (m/s per m/s), so a SLAM that stays where it
+	 * jumped to is followed slowly and mostly while the head moves, and one that comes back cancels its offset.
+	 * Without it (imu_jump_m 0) a SLAM error under pos_snap_m is followed at pos_tau_s and one over it snaps at once
+	 * (2026-11-18 16:43 run: SLAM stepped 10-104 mm with the head nearly still after fast turns, and the view slid and
+	 * jumped with it). Offline on that recording: normal SLAM positions were within 4.5 mm of the IMU's, the glitch's
+	 * 140 updates over 8 mm.
+	 */
+	float imu_jump_m;
+	float imu_jump_per_rad_s;
+	float imu_jump_per_s;
+	float imu_offset_rate_mps;
+	float imu_offset_motion_gain;
+	//! The IMU check judges only while turning slower than this (rad/s, 0: always): fast turns throw the IMU's position
+	//! off too (2026-11-18 16:43 replay: unchecked, 30 cm drift in 0.7 s at 100-270 deg/s).
+	float imu_check_max_rad_s;
+	//! The offset never grows past this (m, 0: no limit): a SLAM that stays further away is followed (blended in).
+	float imu_offset_max_m;
 };
 
