{
  "jsonid": "input_profile",
  "controller_type": "playstation_vr2_hand",
  "device_class": "TrackedDeviceClass_Controller",
  "resource_root": "monado",
  "driver_name": "monado",
  "legacy_binding": "{monado}/input/legacy_binding_playstation_vr2_hand.json",
  "remapping": "{monado}/input/playstation_vr2_hand_remapping.json",
  "input_bindingui_mode": "controller_handed",
  "should_show_binding_errors": true,
  "input_bindingui_left": {
    "image": "{monado}/icons/playstation_vr2/playstation_vr2_sense_left.svg"
  },
  "input_bindingui_right": {
    "image": "{monado}/icons/playstation_vr2/playstation_vr2_sense_right.svg"
  },
  "input_source": {
    "/input/trigger": {
      "type": "trigger",
      "value": true,
      "click": true,
      "binding_image_point": [
        0,
        0
      ]
    },
    "/input/grip": {
      "type": "trigger",
      "value": true,
      "click": true,
      "binding_image_point": [
        0,
        0
      ]
    },
    "/pose/raw": {
      "type": "pose",
      "binding_image_point": [
        0,
        0
      ]
    },
    "/pose/base": {
      "type": "pose",
      "binding_image_point": [
        0,
        0
      ]
    },
    "/pose/handgrip": {
      "type": "pose",
      "binding_image_point": [
        0,
        0
      ]
    },
    "/pose/tip": {
      "type": "pose",
      "binding_image_point": [
        0,
        0
      ]
    },
    "/input/skeleton/left": {
      "type": "skeleton",
      "side": "left",
      "skeleton": "/skeleton/hand/left",
      "binding_image_point": [
        75,
        75
      ]
    },
    "/input/skeleton/right": {
      "type": "skeleton",
      "side": "right",
      "skeleton": "/skeleton/hand/right",
      "binding_image_point": [
        75,
        75
      ]
    }
  }
}